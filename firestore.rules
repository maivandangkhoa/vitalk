rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isTeacher() {
      return hasRole("teacher");
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A teacher profile lives at `teachers/{owner uid}`, so ownership is the
    // document id — no lookup, and no second reference that could disagree.
    // A profile with a generated id has no owner: nobody satisfies this, which
    // is exactly right for one that has not been claimed yet.
    function isTeacherOwner(teacherId) {
      return isAuthenticated() && request.auth.uid == teacherId;
    }

    // Same check for documents that *reference* a teacher.
    function ownsTeacher(teacherId) {
      return isAuthenticated() && teacherId == request.auth.uid;
    }

    // Profile - legacy, kept for backward compat
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Teachers - public read, admin create/delete, teacher+admin update own
    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isTeacherOwner(teacherId);
      allow delete: if isAdmin();

      // Teacher's availability subcollection.
      // Owner/admin have full control; a booking student may only touch the
      // `slots` map + `updatedAt` (to mark/free a slot), nothing else.
      match /availability/{monthId} {
        allow read: if true;
        allow create, delete: if isAdmin() || isTeacherOwner(teacherId);
        allow update: if isAdmin() || isTeacherOwner(teacherId)
          || (isAuthenticated()
              && request.resource.data.diff(resource.data)
                   .affectedKeys().hasOnly(['slots', 'updatedAt']));
      }
    }

    // Lesson Types - public read, admin write
    match /lessonTypes/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy availability - kept for migration period
    match /availability/{monthId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() || isAdmin();
    }

    // Users - own doc read/write, admin read all
    // Non-admins may never set/change their own `role` (prevents
    // self-escalation to admin/teacher). Only admins can.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin()
        || (isOwner(userId) && request.resource.data.get('role', 'user') == 'user');
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'));
      allow delete: if isAdmin();
    }

    // Bookings - students create + read own, teacher read/update own, admin full access
    // On create a student may only book as themselves and cannot pre-mark
    // the booking as paid/confirmed (only Cloud Functions / admin flip those).
    match /bookings/{bookingId} {
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'pending';
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.studentId == request.auth.uid)
        || (isTeacher() && isAuthenticated() && ownsTeacher(resource.data.teacherId));
      allow update: if isAdmin()
        || (isTeacher() && isAuthenticated() && ownsTeacher(resource.data.teacherId));
      allow delete: if isAdmin();
    }

    // Reviews - public read visible, auth create, teacher+admin manage own, student reads own
    match /reviews/{reviewId} {
      allow read: if resource.data.isVisible == true || isAdmin()
        || (isTeacher() && isAuthenticated() && ownsTeacher(resource.data.teacherId))
        || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin()
        || (isTeacher() && isAuthenticated() && ownsTeacher(resource.data.teacherId));
    }

    // Blog Posts - public read published, admin write
    match /blogPosts/{postId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Blog Post Summaries - public read, only Cloud Functions write
    match /blogPostSummaries/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Locations - public read, admin write
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Config - public read, admin write
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mail - only Cloud Functions (deny all client access)
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Conversations - a student/teacher pair's in-app chat.
    // The document id *is* the pair ("{studentId}_{teacherId}"), so a pair can
    // never end up with two conversations and authorization needs no lookup.
    // Admins read everything (dispute handling) but are never participants, so
    // they cannot post — read-only by construction.
    match /conversations/{conversationId} {
      function participants() {
        return resource.data.participants;
      }

      function isParticipant() {
        return isAuthenticated() && request.auth.uid in participants();
      }

      // The participant who is *not* the caller.
      function otherParticipant() {
        return participants()[0] == request.auth.uid
          ? participants()[1]
          : participants()[0];
      }

      // The id *is* the pair, so the two people named in it are known even when
      // the document does not exist yet. That case matters: the first "Message"
      // click reads the thread before creating it, and `resource` is null then —
      // going through `participants()` would error and deny the read.
      function isNamedInId() {
        return isAuthenticated() && request.auth.uid in conversationId.split('_');
      }

      allow read: if isAdmin() || (resource == null ? isNamedInId() : isParticipant());

      // A new conversation starts empty: no messages, both counters at zero.
      // Only the two named people may open it, and the teacher side must be a
      // real teacher profile.
      allow create: if isAuthenticated()
        && conversationId == request.resource.data.studentId + '_' + request.resource.data.teacherId
        && request.resource.data.studentId != request.resource.data.teacherId
        && request.resource.data.participants == [
             request.resource.data.studentId,
             request.resource.data.teacherId
           ]
        && request.auth.uid in request.resource.data.participants
        && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId))
        && !request.resource.data.keys().hasAny(['lastMessage'])
        && request.resource.data.unread[request.resource.data.studentId] == 0
        && request.resource.data.unread[request.resource.data.teacherId] == 0;

      // The only client write to an existing conversation is "I read this":
      // clear your own counter, leave the other side's alone. Everything else
      // (lastMessage, updatedAt, incrementing unread) is Cloud Functions.
      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread'])
        && request.resource.data.unread.get(request.auth.uid, 0) == 0
        && request.resource.data.unread.get(otherParticipant(), 0)
             == resource.data.unread.get(otherParticipant(), 0);

      allow delete: if false;

      match /messages/{messageId} {
        function convo() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function recipient() {
          return convo().participants[0] == request.auth.uid
            ? convo().participants[1]
            : convo().participants[0];
        }

        allow read: if isAdmin()
          || (isAuthenticated() && request.auth.uid in convo().participants);

        // Anti-flood for an open inbox: once this many of your messages sit
        // unread by the other side, you cannot send more until they read.
        allow create: if isAuthenticated()
          && request.auth.uid in convo().participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'image']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && convo().unread.get(recipient(), 0) < 20;

        // Messages are immutable; there is no client-side edit or delete.
        allow update, delete: if false;
      }
    }

    // Video calls - WebRTC signaling for a lesson, at `calls/{bookingId}`.
    // One booking is one room, so the document id *is* the authorization: both
    // the peer check and the room's identity come from the booking itself and
    // cannot drift apart. Admins read for support but are never peers.
    match /calls/{callId} {
      function booking() {
        return get(/databases/$(database)/documents/bookings/$(callId)).data;
      }

      function isPeerOf(b) {
        return isAuthenticated()
          && (request.auth.uid == b.teacherId || request.auth.uid == b.studentId);
      }

      // On an existing room the peers are already written down, so this costs
      // no extra read — only create has to consult the booking.
      function isPeer() {
        return isAuthenticated() && request.auth.uid in resource.data.participants;
      }

      allow read: if isAdmin() || isPeer();

      // A room may only be opened for a confirmed booking, by one of its two
      // people, with the signaling slots empty.
      allow create: if isPeerOf(booking())
        && callId == request.resource.data.bookingId
        && booking().status in ['confirmed', 'completed']
        && request.resource.data.teacherId == booking().teacherId
        && request.resource.data.studentId == booking().studentId
        && request.resource.data.participants == [booking().teacherId, booking().studentId]
        && request.resource.data.offer == null
        && request.resource.data.answer == null
        && request.resource.data.session is int;

      // Signaling only. `participants`, `teacherId`, `studentId` and
      // `bookingId` are fixed at create time — nobody can rewrite who is in the
      // room, which is what keeps the read rule meaningful.
      allow update: if isPeer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'session', 'offer', 'answer',
             'teacherReadyAt', 'studentReadyAt', 'route',
             'startedAt', 'endedAt', 'updatedAt'
           ])
        // Only the teacher *sets* an offer and only the student *sets* an
        // answer. Fixing the roles here is what makes SDP glare impossible.
        //
        // Clearing either one is allowed to both, and has to be: hanging up
        // wipes both fields, and a re-dial publishes a new offer with the old
        // answer nulled. Without these clauses the teacher could never offer
        // twice — the second attempt was denied for touching `answer`, which
        // left rooms stuck mid-call with no way back in. Nulling cannot cause
        // glare; only putting an SDP *in* can.
        && (request.resource.data.offer == resource.data.offer
            || request.auth.uid == resource.data.teacherId
            || request.resource.data.offer == null)
        && (request.resource.data.answer == resource.data.answer
            || request.auth.uid == resource.data.studentId
            || request.resource.data.answer == null)
        // A peer may only claim its own presence.
        && (request.resource.data.teacherReadyAt == resource.data.teacherReadyAt
            || request.auth.uid == resource.data.teacherId)
        && (request.resource.data.studentReadyAt == resource.data.studentReadyAt
            || request.auth.uid == resource.data.studentId);

      allow delete: if false;

      match /candidates/{candidateId} {
        function peers() {
          return get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        }

        allow read: if isAuthenticated() && request.auth.uid in peers();

        // Your own candidates, tagged with the generation you are on. Nobody
        // can inject a candidate attributed to the other side.
        allow create: if isAuthenticated()
          && request.auth.uid in peers()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.session is int;

        // Candidates are facts about one attempt; they are never edited, and
        // the daily cleanup job is what removes them.
        allow update, delete: if false;
      }
    }

    // Notifications - users read/update own (mark-as-read), Cloud Functions write
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
  }
}
