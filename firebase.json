{
  "hosting": {
    "site": "havitalk",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "sitemap",
          "region": "us-central1"
        }
      },
      {
        "source": "/blog",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/blog/*",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/ko/blog",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/ko/blog/*",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/en/blog",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/en/blog/*",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/vi/blog",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/vi/blog/*",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/zh/blog",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/zh/blog/*",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/ja/blog",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "/ja/blog/*",
        "function": {
          "functionId": "blogMeta",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/locales/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  }
}
